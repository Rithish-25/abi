rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public test/package catalog: anyone can browse (even logged out),
    // only the admin can create/edit/delete entries.
    match /tests/{testId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "admin@gmail.com";
    }

    // Public test categories: same as above.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "admin@gmail.com";
    }

    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == "admin@gmail.com";
    }
  }
}
