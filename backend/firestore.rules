rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Development Mode: Allow public read and write access to all collections
    // This allows testing the dashboard with local OTP bypass login without complex auth setup.
    // In production, configure role-based auth.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
